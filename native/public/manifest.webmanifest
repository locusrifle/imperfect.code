{
  "name": "omarchy mobile",
  "short_name": "omarchy",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#000000",
  "theme_color": "#000000",
  "icons": [
    {
      "src": "/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "orientation": "any",
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "recordings",
          "accept": [
            "audio/*",
            "audio/mp4",
            "audio/mpeg",
            "video/*",
            "video/mp4",
            "image/*",
            ".m4a",
            ".mp3",
            ".wav",
            ".ogg",
            ".opus",
            ".aac",
            ".mp4",
            ".mov",
            ".webm"
          ]
        }
      ]
    }
  }
}