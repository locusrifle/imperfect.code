[Unit]
Description=imperfect computers ingress (password gate)
After=network-online.target imperfect.service
Wants=network-online.target

[Service]
Type=simple
# Root-owned binary under /opt, same resume rule as the app.
EnvironmentFile=-/etc/imperfect-ingress.env
Environment=IMPERFECT_PREFIX={{PREFIX}}
ExecStart={{NODE}} {{PREFIX}}/ingress.mjs
Restart=always
RestartSec=3
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
