[Unit]
Description=Locus (imperfect.computer)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{USER}}
Group={{USER}}
WorkingDirectory={{WORKSPACE}}
Environment=HOME={{DATA}}
Environment=IMPERFECT_PREFIX={{PREFIX}}
Environment=PI_CODING_AGENT_DIR={{AGENT}}
Environment=PI_SKIP_VERSION_CHECK=1
Environment=PI_TELEMETRY=0
# Real node under /opt, not a symlink into image tooling. Snapshots keep /opt.
ExecStart={{NODE}} {{PREFIX}}/current/start.mjs
Restart=always
RestartSec=3
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
